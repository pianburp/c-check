{
  "label": "cheat",
  "class": "api-no-auth",
  "mustCatch": [
    "no-data-before-login"
  ],
  "base": "leak-app",
  "serve": "server.js",
  "config": {
    "rules": {
      "no-data-before-login": {
        "mode": "observe",
        "routes": [
          "/login",
          "/api/records"
        ]
      }
    }
  }
}
